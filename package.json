{
  "name": "qa-harness-pilot",
  "version": "1.0.0",
  "description": "Quality engineering harness with Playwright, API contracts, accessibility, and Grafana k6 performance tests.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test tests/e2e",
    "test:api": "npx playwright test tests/api",
    "test:contract": "npx playwright test tests/contract",
    "test:accessibility": "npx playwright test tests/accessibility",
    "test:k6:smoke": "k6 run -e K6_PROFILE=smoke tests/performance/api.js",
    "test:k6:performance": "k6 run -e K6_PROFILE=performance tests/performance/api.js",
    "test:k6:load": "k6 run -e K6_PROFILE=load tests/performance/api.js",
    "test:k6:spike": "k6 run -e K6_PROFILE=spike tests/performance/api.js",
    "test:k6:soak": "k6 run -e K6_PROFILE=soak tests/performance/api.js",
    "test:k6:synthetic": "k6 run -e K6_PROFILE=synthetic tests/performance/api.js",
    "test:headed": "npx playwright test --headed",
    "test:report": "npx playwright show-report",
    "test:mock-server": "node tests/mocks/mock-server.js",
    "install-playwright": "npx playwright install --with-deps chromium webkit",
    "betterwright": "betterwright",
    "betterwright:login": "node ai/betterwright/exploratory/login.mjs",
    "betterwright:agent": "node ai/betterwright/agent.mjs",
    "betterwright:testmodel": "node ai/betterwright/test-model.mjs"
  },
  "keywords": [
    "playwright",
    "e2e",
    "api",
    "contract",
    "accessibility",
    "qa",
    "opencart"
  ],
  "author": "Davidson Luna <davidsonluna@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavidsonLuna/QA-Harness-Pilot.git"
  },
  "bugs": {
    "url": "https://github.com/DavidsonLuna/QA-Harness-Pilot/issues"
  },
  "homepage": "https://github.com/DavidsonLuna/QA-Harness-Pilot#readme",
  "devDependencies": {
    "@playwright/mcp": "^0.0.78",
    "@playwright/test": "1.56",
    "@types/node": "^26.1.2"
  },
  "dependencies": {
    "betterwright": "^1.10.0"
  }
}
